# PaperPilot Server – Environment Variables
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────
# Gemini model to use (defaults to gemini-1.5-pro)
# Options: gemini-1.5-pro | gemini-1.5-flash | gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-pro

# Port the server listens on (default: 3001)
PORT=3001

# Origin allowed by CORS (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
